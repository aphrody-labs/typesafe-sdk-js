{
  "name": "@aphrody/typesafe-sdk",
  "version": "0.6.2",
  "description": "TypeScript SDK for the TypeSafe API",
  "license": "MIT",
  "author": "evinism",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:dist": "vitest run --config vitest.dist.config.ts",
    "check:version": "bun scripts/check-version.mjs",
    "check:package": "bun scripts/check-package.mjs",
    "prepublishOnly": "bun run check",
    "push:npm": "bun publish",
    "push:npm:dry": "bun publish --dry-run",
    "push:jsr": "bun run check && jsr publish",
    "push:jsr:dry": "bun run check && jsr publish --dry-run --allow-dirty",
    "demo": "bun examples/demo.ts",
    "check": "bun run lint && bun run typecheck && bun run check:version && bun run test:coverage && bun run build && bun run test:dist && bun run check:package",
    "docs": "bun install --cwd docs --frozen-lockfile && bun run --cwd docs build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.1.11",
    "git-cliff": "2.13.1",
    "jsr": "^0.14.3",
    "publint": "^0.3.24",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-labs/typesafe-sdk-js.git"
  },
  "homepage": "https://github.com/aphrody-labs/typesafe-sdk-js",
  "bugs": {
    "url": "https://github.com/aphrody-labs/typesafe-sdk-js/issues"
  }
}
